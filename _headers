# Cloudflare Pages response headers.

# Keep everything except the production domain (https://theopenfield.org) out of search
# indexes: the PPE (staging) hostname and every *.pages.dev alias that serves a
# build. This file is the single mechanism for it (no Cloudflare dashboard rules).
https://ppe.theopenfield.org/*
  X-Robots-Tag: noindex, nofollow

https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
