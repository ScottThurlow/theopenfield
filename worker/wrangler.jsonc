{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theopenfield-counter",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "COUNTER",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
